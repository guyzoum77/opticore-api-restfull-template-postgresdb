{
  "name": "opticore-api-restfull-template-postgresdb",
  "version": "1.0.0",
  "description": "Opticore API Restfull template with postgres as database",
  "scripts": {
    "start:prod": "tsx server.ts",
    "start:dev": " tsx server.ts",
    "stop": "sh -c 'lsof -nP -iTCP:4200 -sTCP:LISTEN'",
    "db:migrate": "npx prisma migrate dev --name user-entity --create-only && npx prisma generate",
    "db:push": "npx prisma db push",
    "test": "jest --forceExit --detectOpenHandles",
    "deploy:prod": "npm run build && pm2 start ecosystem.config.js --only prod",
    "deploy:dev": "pm2 start ecosystem.config.js --only dev",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint --ext .ts src/",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint --fix --ext .ts src/"
  },
  "repository": {
    "type": "git",
    "url": "git+ https://github.com/guyzoum77/opticore-api-restfull-template-postgresdb.git"
  },
  "author": "Guy-serge Kouacou",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/guyzoum77/opticore-api-restfull-template-postgresdb.git/issues"
  },
  "homepage": "https://github.com/guyzoum77/opticore-api-restfull-template-postgresdb.git#readme",
  "dependencies": {
    "@types/gradient-string": "^1.1.6",
    "nunjucks": "^3.2.4",
    "opticore-catch-exception-error": "^1.0.28",
    "opticore-env-access": "^1.0.22",
    "opticore-express": "^1.0.9",
    "opticore-feature-component": "^1.0.3",
    "opticore-http-response": "^1.0.10",
    "opticore-loader-translation": "^1.0.8",
    "opticore-logger": "^1.0.31",
    "opticore-postgres": "^1.0.0",
    "opticore-profiler": "1.0.5",
    "opticore-request-call-event": "^1.0.12",
    "opticore-router": "^1.0.22",
    "opticore-server-logger": "^1.0.13",
    "opticore-translator": "^1.0.15",
    "opticore-validator": "^1.0.4",
    "opticore-webapp": "^1.0.85",
    "opticore-webapp-core": "^1.0.20",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^0.1.0",
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^10.8.0",
    "globals": "^16.2.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.34.0"
  },
  "overrides": {
    "qs": "^6.15.3",
    "jws": "^3.2.3",
    "brace-expansion": "^1.1.18",
    "lodash": "^4.18.1",
    "minimatch": "^3.1.5",
    "shell-quote": "^1.10.0",
    "flatted": "^3.4.4",
    "glob": "^10.5.0",
    "rollup": "^4.62.4",
    "esbuild": "^0.28.1",
    "diff": "^4.0.4"
  }
}
